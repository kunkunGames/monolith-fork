{
  "plugin_descriptor": "auto",
  "uplugin": {
    "required_plugin_references": [
      "GameplayAbilities"
    ],
    "forbidden_optional_plugin_references": [
      "Chooser"
    ]
  },
  "source_dir": "Source",
  "severity": {
    "line_endings": "advisory",
    "markdown_lint": "advisory",
    "powershell_analyzer": "advisory",
    "broad_secret_regex": "advisory"
  },
  "buildcs": {
    "release_guard_env": "MONOLITH_RELEASE_BUILD",
    "optional_dependency_tokens": [
      "BlueprintAssist",
      "BlueprintAttributes",
      "ComboGraph",
      "CommonInput",
      "CommonUI",
      "Dataflow",
      "DataflowCore",
      "DataflowEngine",
      "GameplayBehaviors",
      "GameplayBehaviorsModule",
      "GameplayStateTree",
      "GeometryCore",
      "GeometryFramework",
      "GeometryScripting",
      "GeometryScriptingCore",
      "GameFeatures",
      "LogicDriver",
      "MassEntity",
      "MassGameplay",
      "MassGameplayEditor",
      "MassSpawner",
      "Metasound",
      "MetaSoundEngine",
      "MovieRenderPipeline",
      "MovieRenderPipelineCore",
      "MovieRenderPipelineEditor",
      "PropertyBindingUtils",
      "SMSystem",
      "SmartObjects",
      "StateTree",
      "WorldConditions",
      "ZoneGraph"
    ]
  },
  "repo_hygiene": {
    "generated_or_binary_patterns": [
      "(^|/)(Binaries|Intermediate|Saved|DerivedDataCache)/",
      "\\.generated\\.(h|cpp)$",
      "\\.(dll|dylib|so|exe|pdb|obj|o|a|lib)$"
    ]
  },
  "automation_tests": {
    "scan_extensions": [".cpp", ".h", ".hpp"],
    "name_regexes": [
      "IMPLEMENT_(?:SIMPLE_|COMPLEX_)?AUTOMATION_TEST\\s*\\([^,]+,\\s*\"([^\"]+)\""
    ],
    "warn_if_none": true
  },
  "text_hygiene": {
    "line_ending_allowlist": [],
    "scan_extensions": [
      ".bat",
      ".c",
      ".cpp",
      ".cs",
      ".h",
      ".hpp",
      ".ini",
      ".json",
      ".md",
      ".ps1",
      ".py",
      ".sh",
      ".toml",
      ".txt",
      ".uplugin",
      ".uproject",
      ".yaml",
      ".yml"
    ]
  },
  "agent_tools": {
    "agents_dir": ".claude/agents",
    "dispatcher_prefix": "mcp__monolith__",
    "missing_agents_dir_is_error": false
  },
  "routing_hygiene": {
    "enabled": true,
    "scan_extensions": [".cpp", ".h", ".hpp"],
    "high_risk_actions": {
      "niagara": [
        "search_by_parameter",
        "search_by_data_interface",
        "query_niagara",
        "find_similar_systems",
        "search_by_material",
        "find_niagara_references",
        "list_system_data_interfaces"
      ]
    }
  },
  "proxy_smoke": {
    "enabled": true,
    "script": "Scripts/monolith_proxy.py",
    "url_env": "MONOLITH_URL",
    "offline_url": "http://127.0.0.1:9/mcp",
    "expected_server_name": "monolith-proxy",
    "expected_offline_min_tools": 5,
    "required_offline_tools": [
      "monolith_discover",
      "monolith_status",
      "monolith_update",
      "monolith_reindex",
      "monolith_query"
    ],
    "timeout_seconds": 5
  },
  "analyzer_smoke": {
    "enabled": true,
    "script": "Analyzer/analyze_invocation_logs.py",
    "timeout_seconds": 30
  },
  "skill_drift": {
    "enabled": true,
    "script": "Scripts/check_skill_catalog_drift.ps1",
    "mcp_url": "http://localhost:9316/mcp",
    "dump_dir": "Skills/_catalog_dumps",
    "timeout_seconds": 180
  },
  "benchmark_definitions": {
    "enabled": true,
    "definitions": [
      {
        "name": "ActionGuidance",
        "script": "Scripts/action_guidance_benchmark.py",
        "manifest": "Benchmarks/ActionGuidance/manifest.json",
        "tasks": "Benchmarks/ActionGuidance/tasks.jsonl",
        "manifest_count_field": "task_count",
        "manifest_path_field": "task_file",
        "default_path_attrs": {
          "DEFAULT_TASKS": "tasks",
          "DEFAULT_MANIFEST": "manifest"
        }
      },
      {
        "name": "SourceIndex",
        "script": "Scripts/source_index_benchmark.py",
        "manifest": "Benchmarks/SourceIndex/manifest.json",
        "tasks": "Benchmarks/SourceIndex/tasks.jsonl",
        "manifest_count_field": "task_count",
        "manifest_path_field": "task_file",
        "default_path_attrs": {
          "DEFAULT_TASKS": "tasks",
          "DEFAULT_MANIFEST": "manifest"
        }
      },
      {
        "name": "ProjectIndex",
        "script": "Scripts/project_index_benchmark.py",
        "manifest": "Benchmarks/ProjectIndex/manifest.json",
        "tasks": "Benchmarks/ProjectIndex/tasks.jsonl",
        "manifest_count_field": "task_count",
        "manifest_path_field": "task_file",
        "default_path_attrs": {
          "DEFAULT_TASKS": "tasks",
          "DEFAULT_MANIFEST": "manifest"
        }
      },
      {
        "name": "AssetEditing",
        "script": "Scripts/asset_editing_benchmark.py",
        "manifest": "Benchmarks/AssetEditing/manifest.json",
        "tasks": "Benchmarks/AssetEditing/tasks.jsonl",
        "manifest_count_field": "task_count",
        "manifest_path_field": "task_file",
        "default_path_attrs": {
          "DEFAULT_TASKS": "tasks",
          "DEFAULT_MANIFEST": "manifest"
        }
      },
      {
        "name": "AICapability",
        "script": "Scripts/ai_capability_benchmark.py",
        "manifest": "Benchmarks/AICapability/manifest.json",
        "tasks": "Benchmarks/AICapability/tasks.jsonl",
        "manifest_count_field": "task_count",
        "manifest_path_field": "task_file",
        "default_path_attrs": {
          "DEFAULT_TASKS": "tasks",
          "DEFAULT_MANIFEST": "manifest"
        }
      },
      {
        "name": "SchemaCompleteness",
        "script": "Scripts/schema_completeness_benchmark.py",
        "manifest": "Benchmarks/SchemaCompleteness/manifest.json",
        "probe_set": "Benchmarks/SchemaCompleteness/probe_set.jsonl",
        "manifest_count_field": "probe_set_task_count",
        "manifest_path_field": "probe_set_file",
        "default_path_attrs": {
          "DEFAULT_PROBE_SET": "probe_set"
        }
      },
      {
        "name": "OfflineParity",
        "script": "Scripts/offline_parity_benchmark.py",
        "manifest": "Benchmarks/OfflineParity/manifest.json",
        "tasks": "Benchmarks/OfflineParity/actions.jsonl",
        "manifest_count_field": "action_count",
        "manifest_path_field": "action_file",
        "default_path_attrs": {
          "DEFAULT_ACTIONS": "tasks",
          "DEFAULT_MANIFEST": "manifest"
        }
      }
    ]
  },
  "benchmark_contract_tests": {
    "enabled": true,
    "timeout_seconds": 60,
    "tests": [
      {
        "name": "ActionGuidance",
        "script": "Scripts/test_action_guidance_benchmark.py"
      },
      {
        "name": "SourceIndex",
        "script": "Scripts/test_source_index_benchmark.py"
      },
      {
        "name": "ProjectIndex",
        "script": "Scripts/test_project_index_benchmark.py"
      },
      {
        "name": "AssetEditing",
        "script": "Scripts/test_asset_editing_benchmark.py"
      },
      {
        "name": "AICapability",
        "script": "Scripts/test_ai_capability_benchmark.py"
      },
      {
        "name": "OfflineParity",
        "script": "Scripts/test_offline_parity_benchmark.py"
      },
      {
        "name": "ActionGuidanceRoutingWeight",
        "script": "Scripts/tests/test_action_guidance_routing_weight.py"
      },
      {
        "name": "BenchmarkCommonPagination",
        "script": "Scripts/tests/test_benchmark_common_pagination.py"
      },
      {
        "name": "BenchmarkCommonTransportGate",
        "script": "Scripts/tests/test_benchmark_common_transport_gate.py"
      },
      {
        "name": "BenchmarkCommonTaskCorpus",
        "script": "Scripts/tests/test_benchmark_common_task_corpus.py"
      },
      {
        "name": "InvocationLogBenchmarkNoise",
        "script": "Scripts/tests/test_invocation_log_benchmark_noise.py"
      },
      {
        "name": "SchemaCompletenessEnumeration",
        "script": "Scripts/tests/test_schema_completeness_enumeration.py"
      },
      {
        "name": "SchemaCompletenessValueDomain",
        "script": "Scripts/tests/test_schema_completeness_value_domain.py"
      },
      {
        "name": "ReleaseSha256MarkerContract",
        "script": "Scripts/tests/test_release_sha256_marker_contract.py"
      },
      {
        "name": "BenchmarkCIInventory",
        "script": "Scripts/tests/test_benchmark_ci_inventory.py"
      },
      {
        "name": "StaticOfflineParityExeSelection",
        "script": "Scripts/tests/test_ci_static_offline_parity.py"
      }
    ]
  },
  "offline_catalog_snapshot": {
    "enabled": true,
    "generator": "Tools/MonolithQuery/generate_monolith_catalog_snapshot.py",
    "snapshot": "Tools/MonolithQuery/Generated/monolith_catalog_snapshot.json",
    "timeout_seconds": 60
  },
  "offline_exe_freshness": {
    "enabled": true,
    "script": "Scripts/check_offline_exe_fresh.py"
  },
  "offline_parity_smoke": {
    "enabled": true,
    "script": "Scripts/offline_parity_benchmark.py",
    "min_score": 0.80,
    "max_error_rate": 0.10,
    "timeout_seconds": 120
  },
  "workflow": {
    "hosted_static_workflow": ".github/workflows/ci.yml",
    "required_ordered_tokens": [
      "python Tools/MonolithQuery/generate_monolith_catalog_snapshot.py",
      "python Scripts/ci_static_checks.py --config .github/monolith-static-ci.json --github check"
    ],
    "forbidden_tokens": [
      "RunUAT",
      "RunUBT",
      "UnrealEditor-Cmd",
      "Engine/Build",
      "Setup Unreal",
      "Install Unreal"
    ],
    "excluded_workflows": [
      ".github/workflows/macos-build.yml"
    ],
    "duplicate_workflow_paths": [
      ".github/workflows/hosted-static-ci.yml",
      ".github/workflows/static-ci.yml"
    ]
  },
  "secrets": {
    "high_confidence_regexes": [
      "AKIA[0-9A-Z]{16}",
      "gh[pousr]_[A-Za-z0-9_]{36,}",
      "github_pat_[A-Za-z0-9_]{22}_[A-Za-z0-9_]{59}",
      "sk-[A-Za-z0-9]{40,}"
    ],
    "broad_advisory_regexes": [
      "(?i)(api[_-]?key|secret|token|password)\\s*[:=]\\s*['\\\"][^'\\\"]{16,}['\\\"]"
    ]
  }
}
