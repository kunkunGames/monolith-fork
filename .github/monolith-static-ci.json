{
  "plugin_descriptor": "auto",
  "source_dir": "Source",
  "severity": {
    "line_endings": "advisory",
    "markdown_lint": "advisory",
    "powershell_analyzer": "advisory",
    "broad_secret_regex": "advisory"
  },
  "buildcs": {
    "release_guard_env": "MONOLITH_RELEASE_BUILD",
    "optional_dependency_tokens": [
      "BlueprintAssist",
      "BlueprintAttributes",
      "ComboGraph",
      "CommonInput",
      "CommonUI",
      "Dataflow",
      "DataflowCore",
      "DataflowEngine",
      "GameplayBehaviors",
      "GameplayBehaviorsModule",
      "GameplayStateTree",
      "GeometryCore",
      "GeometryFramework",
      "GeometryScripting",
      "GeometryScriptingCore",
      "GameFeatures",
      "LogicDriver",
      "MassEntity",
      "MassGameplay",
      "MassGameplayEditor",
      "MassSpawner",
      "Metasound",
      "MetaSoundEngine",
      "MovieRenderPipeline",
      "MovieRenderPipelineCore",
      "MovieRenderPipelineEditor",
      "PropertyBindingUtils",
      "SMSystem",
      "SmartObjects",
      "StateTree",
      "WorldConditions",
      "ZoneGraph"
    ]
  },
  "repo_hygiene": {
    "generated_or_binary_patterns": [
      "(^|/)(Binaries|Intermediate|Saved|DerivedDataCache)/",
      "\\.generated\\.(h|cpp)$",
      "\\.(dll|dylib|so|exe|pdb|obj|o|a|lib)$"
    ]
  },
  "automation_tests": {
    "scan_extensions": [".cpp", ".h", ".hpp"],
    "name_regexes": [
      "IMPLEMENT_(?:SIMPLE_|COMPLEX_)?AUTOMATION_TEST\\s*\\([^,]+,\\s*\"([^\"]+)\""
    ],
    "warn_if_none": true
  },
  "text_hygiene": {
    "line_ending_allowlist": [],
    "scan_extensions": [
      ".bat",
      ".c",
      ".cpp",
      ".cs",
      ".h",
      ".hpp",
      ".ini",
      ".json",
      ".md",
      ".ps1",
      ".py",
      ".sh",
      ".toml",
      ".txt",
      ".uplugin",
      ".uproject",
      ".yaml",
      ".yml"
    ]
  },
  "agent_tools": {
    "agents_dir": ".claude/agents",
    "dispatcher_prefix": "mcp__monolith__",
    "missing_agents_dir_is_error": false
  },
  "routing_hygiene": {
    "enabled": true,
    "scan_extensions": [".cpp", ".h", ".hpp"],
    "high_risk_actions": {
      "niagara": [
        "search_by_parameter",
        "search_by_data_interface",
        "query_niagara",
        "find_similar_systems",
        "search_by_material",
        "find_niagara_references",
        "list_system_data_interfaces"
      ]
    }
  },
  "proxy_smoke": {
    "enabled": true,
    "script": "Scripts/monolith_proxy.py",
    "url_env": "MONOLITH_URL",
    "offline_url": "http://127.0.0.1:9/mcp",
    "expected_server_name": "monolith-proxy",
    "expected_offline_min_tools": 20,
    "timeout_seconds": 5
  },
  "skill_drift": {
    "enabled": true,
    "script": "Scripts/check_skill_catalog_drift.ps1",
    "mcp_url": "http://localhost:9316/mcp",
    "dump_dir": "Skills/_catalog_dumps",
    "timeout_seconds": 180
  },
  "offline_exe_freshness": {
    "enabled": true,
    "script": "Scripts/check_offline_exe_fresh.py"
  },
  "offline_parity_smoke": {
    "enabled": true,
    "script": "Scripts/offline_parity_benchmark.py",
    "min_score": 0.80,
    "max_error_rate": 0.10,
    "timeout_seconds": 120
  },
  "workflow": {
    "hosted_static_workflow": ".github/workflows/ci.yml",
    "forbidden_tokens": [
      "RunUAT",
      "RunUBT",
      "UnrealEditor-Cmd",
      "Engine/Build",
      "Setup Unreal",
      "Install Unreal"
    ],
    "excluded_workflows": [
      ".github/workflows/macos-build.yml"
    ],
    "duplicate_workflow_paths": [
      ".github/workflows/hosted-static-ci.yml",
      ".github/workflows/static-ci.yml"
    ]
  },
  "secrets": {
    "high_confidence_regexes": [
      "AKIA[0-9A-Z]{16}",
      "gh[pousr]_[A-Za-z0-9_]{36,}",
      "github_pat_[A-Za-z0-9_]{22}_[A-Za-z0-9_]{59}",
      "sk-[A-Za-z0-9]{40,}"
    ],
    "broad_advisory_regexes": [
      "(?i)(api[_-]?key|secret|token|password)\\s*[:=]\\s*['\\\"][^'\\\"]{12,}['\\\"]"
    ]
  }
}
