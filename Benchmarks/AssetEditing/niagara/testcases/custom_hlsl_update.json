  "tasks": [
    {
      "id": "BEB-467",
      "category": "asset_authoring",
      "namespace": "mixed",
      "action": "op_chain",
      "tool": "monolith_query",
      "asset_path": "/Game/Benchmarks/AssetAuthoring",
      "chain": [
        {
          "tool": "asset_query",
          "allow_error": true,
          "args": {
            "action": "delete_assets",
            "asset_paths": [
              "/Game/Benchmarks/AssetAuthoring/NF_BenchHlslUpdate"
            ],
            "allowed_prefixes": [
              "/Game/Benchmarks/AssetAuthoring"
            ],
            "force": true
          }
        },
        {
          "tool": "niagara_query",
          "args": {
            "action": "create_function_from_hlsl",
            "name": "NF_BenchHlslUpdate",
            "save_path": "/Game/Benchmarks/AssetAuthoring/NF_BenchHlslUpdate",
            "hlsl": "OutValue = InValue * 2.0;",
            "inputs": [
              {
                "name": "InValue",
                "type": "float"
              }
            ],
            "outputs": [
              {
                "name": "OutValue",
                "type": "float"
              }
            ],
            "description": "Benchmark CustomHlsl update function"
          },
          "contains": [
            "NF_BenchHlslUpdate",
            "InValue",
            "OutValue"
          ],
          "capture": {
            "function_script_path": "$.asset_path"
          }
        },
        {
          "tool": "niagara_query",
          "args": {
            "action": "set_custom_hlsl_text",
            "script_path": "${function_script_path}",
            "hlsl": "OutValue = InValue * 3.0 + 1.0;"
          },
          "contains": [
            "success",
            "true",
            "NF_BenchHlslUpdate",
            "node_guid",
            "length"
          ]
        },
        {
          "tool": "niagara_query",
          "args": {
            "action": "save_system",
            "asset_path": "${function_script_path}"
          }
        }
      ],
      "verify": [
        {
          "tool": "niagara_query",
          "args": {
            "action": "get_custom_hlsl_text",
            "script_path": "${function_script_path}"
          },
          "contains": [
            "OutValue = InValue * 3.0 + 1.0;",
            "OutValue"
          ],
          "not_contains": [
            "OutValue = InValue * 2.0;"
          ]
        },
        {
          "tool": "niagara_query",
          "args": {
            "action": "get_module_graph",
            "script_path": "${function_script_path}"
          },
          "contains": [
            "Function",
            "InValue",
            "OutValue",
            "CustomHlsl"
          ]
        },
        {
          "tool": "asset_query",
          "args": {
            "action": "inspect_asset",
            "asset_path": "/Game/Benchmarks/AssetAuthoring/NF_BenchHlslUpdate"
          },
          "contains": [
            "NF_BenchHlslUpdate",
            "NiagaraScript"
          ]
        }
      ],
